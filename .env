# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost

# ── Postgres (consumed by the `db` service in compose) ──
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_dev_pw

# ── Prisma (host = compose service name `db`) ───────
DATABASE_URL=postgresql://marketplace:marketplace_dev_pw@db:5432/marketplace?schema=public

# ── Auth ────────────────────────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Stripe (test mode — Phase 2 / 5) ────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PLATFORM_FEE_PERCENTAGE=10

# ── Shippo (Phase 6) ────────────────────────────────
SHIPPO_API_KEY=shippo_test_replace_me

# ── Email (Mailpit in dev) ──────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@marketplace.local

# ── File storage ────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=

# ── Frontend (Vite) ─────────────────────────────────
VITE_API_URL=/api